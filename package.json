{
  "name": "yamas-taverna-greca",
  "version": "0.0.3",
  "description": "Static site for YAMAS - Taverna Greca, a Greek restaurant in San Vitaliano, Italy.",
  "main": "index.html",
  "scripts": {
    "build": "npx mz b",
    "start": "npm run build && npx serve ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeller-dev/yamas-taverna-greca.git"
  },
  "keywords": [
    "yamas",
    "taverna-greca",
    "restaurant",
    "static-site",
    "san-vitaliano"
  ],
  "author": "Hans Zeller",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/zeller-dev/yamas-taverna-greca/issues"
  },
  "homepage": "https://github.com/zeller-dev/yamas-taverna-greca#readme",
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "minimaz-cli": "^0.5.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "serve": "^14.2.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
